# Copy to apps/mobile/.env and fill in with your own project's values.
# See docs/SETUP.md for how to obtain each of these.

# --- Supabase ---
# Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- PowerSync ---
# PowerSync dashboard > your instance > Edit instance
EXPO_PUBLIC_POWERSYNC_URL=https://YOUR-INSTANCE.powersync.journeyapps.com

# --- Google OAuth (Gmail send + Calendar two-way sync) ---
# Google Cloud Console > APIs & Services > Credentials
# Used server-side (Supabase Edge Functions) to exchange/refresh tokens - never ship the client secret in the app bundle.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-PROJECT-REF.supabase.co/functions/v1/google-oauth-callback
