# Copy to apps/mobile/.env and fill in with your Supabase/PowerSync project's
# values - see docs/SETUP.md. Only EXPO_PUBLIC_* vars are readable by the app;
# see the root .env.example for the (server-side only) Google OAuth vars
# used later by the Gmail/Calendar integration.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_POWERSYNC_URL=https://YOUR-INSTANCE.powersync.journeyapps.com

# Base URL of the deployed quote/invoice approval page (see docs/SETUP.md
# "Quote/invoice digital acceptance") - Supabase's shared *.supabase.co
# domain won't render this as an interactive page (forced text/plain +
# a sandboxing CSP header, confirmed by testing both Edge Functions and
# Storage), so the static page in supabase/static/approval-page.html has
# to be deployed to a free external static host (Cloudflare Pages,
# Netlify, etc.) instead. Point this at wherever that ends up living -
# e.g. https://bingley-approval.pages.dev. Leave unset and the "Generate &
# share approval link" button will show a clear error instead of building
# a broken link.
EXPO_PUBLIC_APPROVAL_PAGE_URL=https://YOUR-DEPLOYED-APPROVAL-PAGE.pages.dev
