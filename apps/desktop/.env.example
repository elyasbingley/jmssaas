# Copy to .env and fill in your Supabase project's values (Project Settings
# -> API in the Supabase dashboard - same project the mobile app uses).
# Vite only exposes env vars prefixed VITE_ to client code (its equivalent
# of Expo's EXPO_PUBLIC_ prefix on the mobile side) - see apps/mobile/.env.example
# for the same two values under different var names.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Base URL of the deployed quote/invoice approval page - same page and same
# value as apps/mobile/.env.example's EXPO_PUBLIC_APPROVAL_PAGE_URL (see its
# comment there for why this can't live on Supabase's own shared domain).
# Leave unset and the "Generate approval link" button will show a clear
# error instead of building a broken link.
VITE_APPROVAL_PAGE_URL=https://YOUR-DEPLOYED-APPROVAL-PAGE.pages.dev

# Google Maps JavaScript API key for the roof measurement tool's satellite
# map (mobile's own equivalent, GOOGLE_MAPS_API_KEY_ANDROID, is a native
# Android SDK key baked into a manifest at build time - this one is a
# browser JS API key, deliberately VITE_-prefixed and shipped in the client
# bundle, which is how Google's own JS API is designed to be used: protect
# it with HTTP referrer restrictions in the Google Cloud Console instead of
# hiding it, since a bundled JS key can never truly be secret. Create one
# at https://console.cloud.google.com/google/maps-apis, enable "Maps
# JavaScript API", "Geocoding API", and "Maps Static API" on it, then
# restrict it (Application restrictions -> HTTP referrers) to this app's
# deployed domain(s) plus http://localhost:5173/* for local dev. See
# docs/SETUP.md's roof measurement section for the full architecture.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-js-api-key
